{
  "name": "Hello World app",
  "initializeCommand": ["bash", ".devcontainer/initialize.sh"],
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.personal.yml"
  ],
  "workspaceFolder": "${localWorkspaceFolder}",
  "service": "devcontainer",
  "remoteUser": "vscode",
  "forwardPorts": [
    8000,
    "mailpit:8025",
    5678
  ],
  "portsAttributes": {
    "8000": {
      "label": "Django Dev Server",
      "onAutoForward": "notify"
    },
    "8025": {
      "label": "Mailpit",
      "onAutoForward": "notify"
    },
    "443": {
      "label": "HTTPS",
      "protocol": "https",
      "onAutoForward": "openBrowser"
    },
    "5678": {
      "label": "debugpy",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "uv venv --clear --no-managed-python ${containerWorkspaceFolder}/.venv && just install",
  "postStartCommand": "uv sync --locked && uv run pre-commit gc",
  "mounts": [
    "type=bind,source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent"
  ],
  "containerEnv": {
    "DISPLAY": "dummy"
  },
  "remoteEnv": { "SSH_AUTH_SOCK": "/ssh-agent" },
  "features": {
    "ghcr.io/jsburckhardt/devcontainer-features/just:1": {},
    "ghcr.io/nlstn/devcontainer-features/psql:1": {},
    "ghcr.io/devcontainers-extra/features/kubectl-asdf:2": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.debugpy",
        "redhat.vscode-yaml",
        "skellock.just",
        "tamasfe.even-better-toml",
        "typefox.open-collaboration-tools",
        "yzhang.markdown-all-in-one",
        "astral-sh.ty",
        "batisteo.vscode-django",
        "formulahendry.auto-rename-tag",
        "monosans.djlint"
      ],
      "settings": {
        "python.languageServer": "None",
        "python.testing.unittestEnabled": false,
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "files.watcherExclude": {
          ".venv/**": true,
          "**/__pycache__/**": true,
          "**/.ruff_cache/**": true,
          "**/.pytest_cache/**": true
        },
        "basedpyright.disableLanguageServices": true,
        "python.analysis.typeCheckingMode": "off",
        "python.terminal.useEnvFile": true,
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
